# Convex Backend URL
CONVEX_SITE_URL=https://your-convex-deployment.convex.site

# Base URL for this website
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Keep payment UI in honest preview mode until the backend's live Lemon
# Squeezy purchase/cancel/refund loop has passed.
NEXT_PUBLIC_YAVER_RELAY_PRO_CHECKOUT_ENABLED=false

# OAuth Providers (get from respective developer consoles)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_AUTH_URL=
OAUTH_GOOGLE_TOKEN_URL=
OAUTH_GOOGLE_USERINFO_URL=

OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT_ID=
OAUTH_MICROSOFT_AUTH_URL=
OAUTH_MICROSOFT_TOKEN_URL=
OAUTH_MICROSOFT_USERINFO_URL=
OAUTH_MICROSOFT_JWKS_URL=
OAUTH_MICROSOFT_ISSUER=

# Apple Sign-In (get from Apple Developer Console)
OAUTH_APPLE_CLIENT_ID=your.apple.services.id
OAUTH_APPLE_CLIENT_SECRET=
OAUTH_APPLE_AUTH_URL=
OAUTH_APPLE_TOKEN_URL=
OAUTH_APPLE_JWKS_URL=

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_AUTH_URL=
OAUTH_GITHUB_TOKEN_URL=
OAUTH_GITHUB_USERINFO_URL=
OAUTH_GITHUB_EMAILS_URL=

OAUTH_GITLAB_CLIENT_ID=
OAUTH_GITLAB_CLIENT_SECRET=
OAUTH_GITLAB_AUTH_URL=
OAUTH_GITLAB_TOKEN_URL=
OAUTH_GITLAB_USERINFO_URL=
