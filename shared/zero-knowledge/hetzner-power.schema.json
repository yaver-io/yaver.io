{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaver.io/protocol/hetzner-power-v1.schema.json",
  "title": "Yaver endpoint-only Hetzner power request",
  "description": "Inner protocol payload. It must be encrypted before crossing a Yaver-operated relay. The Hetzner credential is never a field in this protocol.",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["list", "power_on", "shutdown"]
    },
    "serverId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "confirm": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "action": { "enum": ["power_on", "shutdown"] } },
        "required": ["action"]
      },
      "then": {
        "required": ["serverId", "confirm"],
        "properties": { "confirm": { "const": true } }
      }
    }
  ]
}
