{
  "name": "yaver-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end browser tests for yaver.io (landing page + auth flow). Uses Playwright; chosen over Selenium for first-class GitHub Actions support, parallel browser runs, and built-in tracing.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:mobile-workspace-examples": "node mobile-workspace-examples.mjs",
    "test:mobile-workspace-onboarding": "node mobile-workspace-onboarding-live.mjs",
    "browser-queue:validate": "node browser-automation/validate.mjs",
    "browser-queue:open": "node browser-automation/open-session.mjs",
    "mobile-test": "node mobile-test/mobile-test.mjs",
    "mobile-test:test": "node --test mobile-test/mobile-test.test.mjs",
    "report": "playwright show-report",
    "install-browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "selenium-webdriver": "^4.46.0"
  }
}
