<?xml version="1.0" encoding="utf-8"?>
<!--
  Yaver Android TV app manifest.

  This is a STANDALONE Android TV app (Jetpack Compose), the Android counterpart
  of the native tvOS app (tvos/YaverTV): same lean-back runtime-control surface,
  same LAN-first / relay-second transport, same phone-mediated device-code
  sign-in. It is a distinct TV-targeted AAB under the existing io.yaver.mobile
  Play listing. Its required Leanback feature and dedicated tv:internal track
  keep distribution separate from the phone AAB; the Kotlin namespace remains
  io.yaver.tv and does not determine the Play application ID.

  The TV app connects to LAN boxes (plain HTTP) and to the HTTPS relay. Android
  9+ blocks cleartext by default, so usesCleartextTraffic is on: LAN boxes are
  HTTP by nature (the relay leg is always HTTPS, and the relay password travels
  only in the X-Relay-Password header, never in a URL).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- This is the TV app: Leanback is REQUIRED, touchscreen is NOT. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Device-code sign-in against Convex + LAN/relay HTTP to boxes. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wake/unlock flows + the LAN approval beacon are network-only; no extra
         permissions required. TTS needs none. -->

    <application
        android:name=".TvApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.YaverTV"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="io.yaver.native_app_manifest_schema_version"
            android:value="1" />
        <meta-data
            android:name="io.yaver.native_runtime_kind"
            android:value="yaver-agent-client" />
        <meta-data
            android:name="io.yaver.native_runtime_surfaces"
            android:value="android-tv" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.YaverTV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
