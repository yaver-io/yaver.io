<Page x:Class="YaverXbox.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PageBackground}">
  <Grid Padding="72,48">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="YAVER" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
      <TextBlock Text="Your coding machines, from the sofa." FontSize="40" FontWeight="SemiBold" Margin="0,8,0,28" />
    </StackPanel>

    <Grid Grid.Row="1">
      <StackPanel x:Name="SignedOutPanel" MaxWidth="920" HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock Text="Connect this Xbox" FontSize="34" FontWeight="SemiBold" />
        <TextBlock Text="Approve on a phone or computer. Yaver never asks you to type your account password on the TV."
                   FontSize="23" TextWrapping="Wrap" Opacity="0.78" Margin="0,14,0,18" />
        <TextBlock x:Name="UserCodeText" Text="—" FontFamily="Consolas" FontSize="64" CharacterSpacing="120"
                   Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4" />
        <TextBlock x:Name="VerifyUrlText" Text="yaver.io/auth/device" FontSize="22" Opacity="0.7" Margin="0,0,0,18" />
        <StackPanel Orientation="Horizontal">
          <Button x:Name="StartSignInButton" Content="Start sign-in" Click="StartSignIn_Click" />
          <Button Content="Retry" Click="StartSignIn_Click" />
        </StackPanel>
      </StackPanel>

      <Grid x:Name="SignedInPanel" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,40,0">
          <TextBlock Text="Machines" FontSize="32" FontWeight="SemiBold" />
          <TextBlock Text="Choose an authorized machine, inspect its tasks, and watch browser verification recordings."
                     FontSize="20" Opacity="0.68" TextWrapping="Wrap" Margin="0,8,0,20" />
          <ListView x:Name="MachineList" IsItemClickEnabled="True" ItemClick="MachineList_ItemClick" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Background="{StaticResource CardBackground}" Padding="24" Margin="0,0,0,12" MinHeight="92">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" FontSize="18" Opacity="0.65" Margin="0,5,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="19" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Top">
          <TextBlock Text="Verified tasks" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,12" />
          <ListView x:Name="TaskList" IsItemClickEnabled="True" ItemClick="TaskList_ItemClick" SelectionMode="Single" MaxHeight="330">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Background="{StaticResource CardBackground}" Padding="18" Margin="0,0,0,10">
                  <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding DisplayLine}" FontSize="16" Opacity="0.7" Margin="0,4,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <MediaElement x:Name="ProofPlayer" AreTransportControlsEnabled="True" AutoPlay="True" Height="240" Stretch="Uniform" Margin="0,14,0,14" />
          <Button Content="Refresh machines" Click="RefreshMachines_Click" />
          <Button Content="Sign out" Click="SignOut_Click" />
        </StackPanel>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="2" x:Name="StatusText" Text="Ready" FontSize="18" Opacity="0.68" Margin="0,24,0,0" />
  </Grid>
</Page>
