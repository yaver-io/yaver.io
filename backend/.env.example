# Convex deployment URL (set automatically by `npx convex dev`)
# CONVEX_URL is typically set by the Convex CLI, not manually

# Payment launch gate. Keep false/unset while using the owner-only real-relay
# activation stub. Set true only after the live Lemon Squeezy loop is proven.
YAVER_RELAY_PRO_CHECKOUT_ENABLED=false

# Production relay provisioning also requires provider credentials and an
# immutable image reference in the Convex environment. Never put real values in
# this file.
YAVER_RELAY_IMAGE=ghcr.io/example/yaver-relay@sha256:replace-with-64-hex-characters

# Existing shared Free + Pro anchor. Values are deployment inventory, not
# source-code constants. The anchor is pinned and cannot be deleted by a
# cancellation webhook. Leave unset until the existing Yaver relay has been
# identified and its authenticated health path has passed.
# YAVER_RELAY_HYBRID_HOST_KEY=relay-hybrid-anchor-eu
# YAVER_RELAY_HYBRID_REGION=eu
# YAVER_RELAY_HYBRID_SERVER_ID=provider-server-id
# YAVER_RELAY_HYBRID_SERVER_IP=203.0.113.10
# YAVER_RELAY_HYBRID_SERVER_IPV6=2001:db8::1
# YAVER_RELAY_HYBRID_DOMAIN=relay.example.com
# YAVER_RELAY_HYBRID_PAID_CAPACITY=10

# Cost circuit breakers. Dynamic VPS creation is OFF by default. Enable only
# after the anchor is full, billing is live, and the live provider price/cap
# has been reviewed. The host ceiling is absolute, even under webhook bursts.
YAVER_RELAY_DYNAMIC_PROVISIONING_ENABLED=false
YAVER_RELAY_MAX_DYNAMIC_HOSTS=2
YAVER_RELAY_MAX_HOURLY_EUR=0.04
