<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <!-- The release artifact must match the Play FGS declaration: SandboxService
       uses specialUse and RemotelessTaskService uses dataSync. Never strip the
       shared FOREGROUND_SERVICE permission while retaining either service. -->

  <application>
    <!-- These library services are not Yaver's declared FGS features. Keep
         them out of the merged release manifest unless a product flow starts
         using and declaring them deliberately. -->
    <service android:name="expo.modules.location.services.LocationTaskService" tools:node="remove"/>
    <service android:name="app.notifee.core.ForegroundService" tools:node="remove"/>
  </application>
</manifest>
